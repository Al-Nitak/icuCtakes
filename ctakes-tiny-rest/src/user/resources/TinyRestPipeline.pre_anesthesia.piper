// Pre-anesthesia Tiny REST pipeline — same NER stack as TinyRestPipeline.piper.
// Selected at runtime via ?pack=pre_anesthesia (see TinyController / RestPipelineRunner).
//
// Keep this piper structurally identical to the ICU TinyRestPipeline.piper so Drug NER /
// ClearTK attributes stay stable. Specialty section headers are applied in Rails
// (EntityAligner + PreAnesthesiaSectionRegex.bsv); do NOT switch to FullTokenizerPipeline
// here — BsvRegexSectionizer + bare DrugMentionAnnotator caused IndexOutOfBoundsException.

set WriteBanner=yes

load DefaultTokenizerPipeline
add ContextDependentTokenizerAnnotator
addDescription POSTagger
load ChunkerSubPipe

set LookupXml=resources/org/apache/ctakes/dictionary/lookup/fast/sno_rx_16ab_no_umls.xml
add DefaultJCasTermAnnotator LookupXml=resources/org/apache/ctakes/dictionary/lookup/fast/sno_rx_16ab_no_umls.xml

// Dose / route / frequency modifiers — same params as ICU TinyRestPipeline.piper.
add org.apache.ctakes.drugner.ae.DrugMentionAnnotator DISTANCE="1" DISTANCE_ANN_TYPE=org.apache.ctakes.typesystem.type.textspan.Sentence STATUS_BOUNDARY_ANN_TYPE=org.apache.ctakes.typesystem.type.textspan.Sentence

load AttributeCleartkSubPipe
load org/apache/ctakes/icu/pipeline/IcuSlotSubPipe

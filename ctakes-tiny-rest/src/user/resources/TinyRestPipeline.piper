// Tiny REST always loads a piper named TinyRestPipeline.piper from the classpath.
// No-UMLS explore tour default for local testing.

set WriteBanner=yes

load DefaultTokenizerPipeline
add ContextDependentTokenizerAnnotator
addDescription POSTagger
load ChunkerSubPipe

set LookupXml=resources/org/apache/ctakes/dictionary/lookup/fast/ctakesicd2015_no_umls.xml
add DefaultJCasTermAnnotator LookupXml=resources/org/apache/ctakes/dictionary/lookup/fast/ctakesicd2015_no_umls.xml

load AttributeCleartkSubPipe
load org/apache/ctakes/icu/pipeline/IcuSlotSubPipe

// Must match ctakes-tiny-rest TinyRestPipeline.piper.
// This file is on the WAR classpath via ctakes-user-resources → ctakes-examples;
// FileLocator prefers classpath streams, so a stale copy here overrides the filesystem piper.

// Local/dev Tiny REST pipeline (default). No UMLS license check.
// Production uses TinyRestPipeline.prod.piper via:
//   -Dctakes.rest.piper=TinyRestPipeline.prod.piper
//   or CTAKES_REST_PIPER=TinyRestPipeline.prod.piper

set WriteBanner=yes

load DefaultTokenizerPipeline
add ContextDependentTokenizerAnnotator
addDescription POSTagger
load ChunkerSubPipe

set LookupXml=resources/org/apache/ctakes/dictionary/lookup/fast/ctakesicd2015_no_umls.xml
add DefaultJCasTermAnnotator LookupXml=resources/org/apache/ctakes/dictionary/lookup/fast/ctakesicd2015_no_umls.xml

load AttributeCleartkSubPipe
load org/apache/ctakes/icu/pipeline/IcuSlotSubPipe

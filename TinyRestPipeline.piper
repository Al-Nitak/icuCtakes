// Local/dev Tiny REST pipeline (default).
// Uses SNOMED+RxNorm (sno_rx_16ab) without NIH UMLS license check.
// Production uses TinyRestPipeline.prod.piper via:
//   -Dctakes.rest.piper=TinyRestPipeline.prod.piper
//   or CTAKES_REST_PIPER=TinyRestPipeline.prod.piper
// Requires unpacked dictionary DB at:
//   resources/org/apache/ctakes/dictionary/lookup/fast/sno_rx_16ab/

set WriteBanner=yes

// ICU section headers (Plan / Care plan for today / systems) — set before tokenizer load
// so PropertyAeFactory binds SectionsBsv; sectionizer runs after DefaultTokenizer so
// sentence+token offsets stay stable for DrugMentionAnnotator (avoid FullTokenizer swap).
set SectionsBsv=org/apache/ctakes/icu/sections/IcuHandoverSectionRegex.bsv

load DefaultTokenizerPipeline
add BsvRegexSectionizer SectionsBsv=org/apache/ctakes/icu/sections/IcuHandoverSectionRegex.bsv

add ContextDependentTokenizerAnnotator
addDescription POSTagger
load ChunkerSubPipe

set LookupXml=resources/org/apache/ctakes/dictionary/lookup/fast/sno_rx_16ab_no_umls.xml
add DefaultJCasTermAnnotator LookupXml=resources/org/apache/ctakes/dictionary/lookup/fast/sno_rx_16ab_no_umls.xml

// Dose / route / frequency modifiers on MedicationMention spans.
// ICU LexiconMedicationAnnotator still fills ASR aliases / ICU-only names.
add org.apache.ctakes.drugner.ae.DrugMentionAnnotator DISTANCE="1" DISTANCE_ANN_TYPE=org.apache.ctakes.typesystem.type.textspan.Sentence STATUS_BOUNDARY_ANN_TYPE=org.apache.ctakes.typesystem.type.textspan.Sentence

load AttributeCleartkSubPipe
load org/apache/ctakes/icu/pipeline/IcuSlotSubPipe
